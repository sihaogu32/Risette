{
  "name": "risette",
  "version": "1.0.0",
  "description": "Opinionated pi-coding-agent CLI: financial news + safety extensions + playwright skill, one install.",
  "license": "MIT",
  "author": "sihaogu32",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sihaogu32/Risette.git"
  },
  "homepage": "https://github.com/sihaogu32/Risette#readme",
  "type": "module",
  "bin": {
    "risette": "bin/risette.mjs"
  },
  "main": "./dist/entry.js",
  "exports": {
    ".": {
      "types": "./dist/entry.d.ts",
      "import": "./dist/entry.js"
    }
  },
  "files": [
    "bin/",
    "dist/",
    "skills/",
    "scripts/",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "pi",
    "pi-coding-agent",
    "agent",
    "cli",
    "financial-news"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "start": "node bin/risette.mjs",
    "prepublishOnly": "npm run clean && npm run build",
    "postinstall": "node scripts/postinstall.mjs || true"
  },
  "dependencies": {
    "@mariozechner/pi-coding-agent": "^0.70.5",
    "@mariozechner/pi-ai": "^0.70.5",
    "@mariozechner/pi-tui": "^0.70.5",
    "@mariozechner/pi-agent-core": "^0.70.5",
    "pi-subagents": "^0.24.0",
    "typebox": "^0.34.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "pi": {
    "extensions": ["./dist/extensions"]
  }
}
